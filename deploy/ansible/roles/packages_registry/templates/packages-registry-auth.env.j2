# Managed by Ansible. Contains secrets; do not edit or copy into settings.json.
AUTH_DATABASE_URL={{ packages_auth_values.packages_auth_database_url | packages_auth_environment_quote }}
AUTH_SECRET={{ packages_auth_values.packages_auth_secret | packages_auth_environment_quote }}
OAUTH_STATE_SECRET={{ packages_auth_values.packages_auth_oauth_state_secret | packages_auth_environment_quote }}
MFA_RECOVERY_PEPPER={{ packages_auth_values.packages_auth_mfa_recovery_pepper | packages_auth_environment_quote }}
MFA_ENCRYPTION_KEY={{ packages_auth_values.packages_auth_mfa_encryption_key | packages_auth_environment_quote }}
REDIS_URL={{ packages_auth_values.packages_auth_redis_url | packages_auth_environment_quote }}
SMTP_HOST={{ packages_auth_values.packages_auth_smtp_host | packages_auth_environment_quote }}
SMTP_USERNAME={{ packages_auth_values.packages_auth_smtp_username | packages_auth_environment_quote }}
SMTP_PASSWORD={{ packages_auth_values.packages_auth_smtp_password | packages_auth_environment_quote }}
SMTP_FROM_EMAIL={{ packages_auth_values.packages_auth_smtp_from_email | packages_auth_environment_quote }}
GITHUB_CLIENT_ID={{ packages_auth_values.packages_auth_github_client_id | packages_auth_environment_quote }}
GITHUB_CLIENT_SECRET={{ packages_auth_values.packages_auth_github_client_secret | packages_auth_environment_quote }}
GOOGLE_CLIENT_ID={{ packages_auth_values.packages_auth_google_client_id | packages_auth_environment_quote }}
GOOGLE_CLIENT_SECRET={{ packages_auth_values.packages_auth_google_client_secret | packages_auth_environment_quote }}
APP_ENVIRONMENT=production
APP_BASE_URL=https://{{ packages_registry_domain }}
# API_BASE_URL is an origin: OAuth appends /api/v1/auth itself.
API_BASE_URL=https://{{ packages_registry_domain }}
JWT_ISSUER=https://{{ packages_registry_domain }}/api
CORS_ORIGINS=https://{{ packages_registry_domain }}
TRUSTED_PROXIES=127.0.0.1/32
AUTH_COOKIE_SECURE=true
REFRESH_REQUIRE_ORIGIN=true
AUTH_RATE_LIMIT_BACKEND=redis
RATE_LIMIT_FAIL_CLOSED=true
REDIS_ENABLED=true
WEBAUTHN_RP_ID={{ packages_registry_domain }}
WEBAUTHN_ORIGIN=https://{{ packages_registry_domain }}
SMTP_USE_TLS=true
SMTP_PORT=587
