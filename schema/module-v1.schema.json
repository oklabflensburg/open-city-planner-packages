{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packages.stadtplaner.oklabflensburg.de/schema/module-v1.schema.json",
  "title": "Open City Planner Registry Module Metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "publisher",
    "classification",
    "source_repository",
    "license",
    "versions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "classification": {
      "type": "string",
      "enum": ["first-party", "reviewed-community"]
    },
    "source_repository": { "$ref": "#/$defs/httpsUrl" },
    "license": { "type": "string", "minLength": 1, "maxLength": 255 },
    "homepage": { "$ref": "#/$defs/httpsUrl" },
    "documentation_url": { "$ref": "#/$defs/httpsUrl" },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/release" }
    }
  },
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "versionRange": {
      "type": "string",
      "pattern": "^(?:>=|<=|==|!=|>|<)[0-9A-Za-z.+-]+(?:,(?:>=|<=|==|!=|>|<)[0-9A-Za-z.+-]+)*$"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "channel",
        "artifact",
        "bundle_format_version",
        "source_commit",
        "requires"
      ],
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "channel": { "type": "string", "enum": ["stable", "beta", "nightly"] },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "sha256"],
          "properties": {
            "url": { "$ref": "#/$defs/httpsUrl" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "bundle_format_version": { "const": 1 },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$" },
        "source_tag": { "type": "string", "minLength": 1, "maxLength": 255 },
        "requires": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "sdk", "modules"],
          "properties": {
            "host": { "$ref": "#/$defs/versionRange" },
            "sdk": { "$ref": "#/$defs/versionRange" },
            "modules": {
              "type": "object",
              "propertyNames": { "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
              "additionalProperties": { "$ref": "#/$defs/versionRange" }
            }
          }
        }
      }
    }
  }
}
